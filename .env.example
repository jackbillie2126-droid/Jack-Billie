# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public production URL or Netlify deployment URL for ScoutTool.
APP_URL="https://scout-toool.netlify.app"

# CANONICAL_URL: Base canonical domain for ScoutTool SEO indexing.
CANONICAL_URL="https://scout-toool.netlify.app"

# MAX_PAGES_PER_SCAN: Maximum public subpages to crawl per target domain (default: 20).
MAX_PAGES_PER_SCAN=20

# SCRAPER_TIMEOUT_MS: Timeout per HTTP webpage request in milliseconds (default: 7000).
SCRAPER_TIMEOUT_MS=7000
